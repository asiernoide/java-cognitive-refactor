PROJECTS_DIR=projects
DATA_DIR=data
CC_THRESHOLD=15
WORK_DIR=out

# Refactorización
REFACTOR_CYCLO_PENALTY=1
REFACTOR_MAX_CYCLO_DELTA_PCT=0
REFACTOR_SEED=42
REFACTOR_MAX_TOKENS=300000
REFACTOR_MODE=batch
REFACTOR_BATCH_MAX_TOKENS=300000
REFACTOR_BATCH_TIMEOUT=600
REFACTOR_BATCH_RETRIES=2
# Último recurso tras agotar los reintentos de batch: reintento individual (stream)
REFACTOR_STREAM_FALLBACK=1
# Límites por llamada batch (si se superan, el JSON del modelo se trunca)
REFACTOR_BATCH_MAX_METHODS=3
REFACTOR_BATCH_OUTPUT_BUDGET=6000
REFACTOR_RUN_TESTS=never

# Interfaz (1 = abre una consola con el panel de progreso del bucle)
SHOW_TERMINAL=0

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=your_opencode_go_api_key_here
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=300000
LLM_TIMEOUT=120
LLM_REASONING_EFFORT=low